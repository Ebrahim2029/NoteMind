# Copy this file to .env and fill in your own values. Never commit .env.

# PostgreSQL
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=smart_notes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# ChromaDB
CHROMA_HTTP_URL=http://chroma:8000
CHROMA_NAME_DATABASE=notes_db
RETRIEVAL_THRESHOLD=0.7

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

# JWT
JWT_SECRET=change_me
JWT_ALG=HS256
JWT_EXP_MINUTES=60

# Rate limiting
API_RATE_LIMIT_PER_MIN=60

# Redis Streams (note sync worker)
NOTES_STREAM=notes:events
STREAM_GROUP=sync-workers
STREAM_CONSUMER=worker-1
STREAM_BLOCK_MS=5000
STREAM_BATCH=100

# Application
APP_ENV=development
APP_DEBUG=True
